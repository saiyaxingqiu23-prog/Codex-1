# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fluentmind"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-strong-random-secret"

# OpenAI (optional for local testing; app uses local mock responses when missing)
OPENAI_API_KEY=""

# Local testing bypass (development only)
ENABLE_DEV_AUTH_BYPASS="true"
DEV_BYPASS_USER_ID="demo-user-id"
